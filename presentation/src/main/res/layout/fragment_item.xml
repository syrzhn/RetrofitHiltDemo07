<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#151515">

    <RelativeLayout
        android:id="@+id/content"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <RelativeLayout
            android:id="@+id/course_1"
            android:layout_width="328dp"
            android:layout_height="236dp"
            android:background="@drawable/course_1">

            <RelativeLayout
                android:id="@+id/top_section"
                android:layout_width="328dp"
                android:layout_height="114dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/cover_title_course">

                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="328dp"
                    android:layout_height="114dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="-1dp"
                    android:background="@drawable/cover_course_1"
                    android:contentDescription="cover image">

                </ImageView>

                <ImageView
                    android:id="@+id/bookmark"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="92dp"
                    android:background="@drawable/bookmark"
                    android:contentDescription="bookmark image">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/info"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="84dp">

                    <RelativeLayout
                        android:id="@+id/info_1"
                        android:layout_width="40dp"
                        android:layout_height="22dp"
                        android:background="@drawable/info_1">

                        <ImageView
                            android:id="@+id/star_fill"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="23dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/star_fill">

                        </ImageView>

                        <TextView
                            android:id="@+id/rate"
                            android:layout_width="18dp"
                            android:layout_height="17dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="3dp"
                            android:layout_marginBottom="1dp"
                            android:gravity="top"
                            android:lineSpacingExtra="0sp"
                            android:text="@string/star_count"
                            android:textAppearance="@style/star_count" />
                        <!--
                        Font family: Roboto
                        Line height: 14sp
                        (identical to box height)
                        -->

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/info_start_date"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="45dp"
                        android:background="@drawable/info_2">

                        <TextView
                            android:id="@+id/startDate"
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="1dp"
                            android:layout_marginBottom="1dp"
                            android:gravity="top"
                            android:lineSpacingExtra="0sp"
                            android:text="@string/some_id"
                            android:textAppearance="@style/some_id" />
                        <!--
                        Font family: Roboto
                        Line height: 14sp
                        (identical to box height)
                        -->

                    </RelativeLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/info_publish_date"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="13dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/info_2">

                    <!--
                        Font family: Roboto
                        Line height: 14sp
                        (identical to box height)
                        -->

                    <TextView
                        android:id="@+id/publishDate"
                        android:layout_width="wrap_content"
                        android:layout_height="19dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="1dp"
                        android:layout_marginBottom="2dp"
                        android:fontFamily="@font/roboto"
                        android:gravity="top"
                        android:lineSpacingExtra="0sp"
                        android:text="@string/some_id"
                        android:textAppearance="@style/some_id" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/itemId"
                    android:layout_width="53dp"
                    android:layout_height="19dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="91dp"
                    android:fontFamily="@font/roboto"
                    android:gravity="top"
                    android:lineSpacingExtra="0sp"
                    android:text="@string/some_id"
                    android:textAppearance="@style/some_id" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/bottom_sect"
                android:layout_width="300dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="130dp">


                <RelativeLayout
                    android:id="@+id/bottom_info"
                    android:layout_width="296dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp">

                    <!--
                    Font family: Roboto
                    Line height: 18sp
                    (identical to box height)
                    -->
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="296dp"
                        android:layout_height="20dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="66dp"
                        android:gravity="top"
                        android:lineSpacingExtra="-1sp"
                        android:text="@string/bottom_title"
                        android:textAppearance="@style/bottom_title" />

                    <RelativeLayout
                        android:id="@+id/bottom_info_2"
                        android:layout_width="296dp"
                        android:layout_height="60dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/text"
                            android:layout_width="296dp"
                            android:layout_height="36dp"
                            android:alpha="0.7"
                            android:gravity="top"
                            android:lineSpacingExtra="2sp"
                            android:text="@string/description"
                            android:textAppearance="@style/description"
                            android:translationY="-0.97sp" />
                        <!--
                        Font family: Roboto
                        Line height: 16sp
                        translationY compensates for the line height adjustment of text
                        -->
                        <TextView
                            android:id="@+id/price"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="229dp"
                            android:layout_marginBottom="5dp"
                            android:gravity="top"
                            android:lineSpacingExtra="-1sp"
                            android:text="@string/price"
                            android:textAppearance="@style/price" />
                        <!--
                        Font family: Roboto
                        Line height: 18sp
                        (identical to box height)
                        -->
                        <RelativeLayout
                            android:id="@+id/button_more"
                            android:layout_width="200dp"
                            android:layout_height="16dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="200dp"
                            android:layout_marginTop="39dp">

                            <!--
                            Font family: Roboto
                            Line height: 15sp
                            (identical to box height)
                            translationY compensates for the line height adjustment of text
                            -->

                            <TextView
                                android:id="@+id/button_more_text"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="top"
                                android:lineSpacingExtra="1sp"
                                android:text="@string/button_more_text"
                                android:textAppearance="@style/button_more_text"
                                android:translationY="-0.47sp" />

                            <ImageView
                                android:id="@+id/arrow_right"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/arrow_right_short_fill" />


                        </RelativeLayout>

                    </RelativeLayout>


                </RelativeLayout>
            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>