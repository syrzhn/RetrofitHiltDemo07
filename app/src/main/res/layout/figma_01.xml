<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/some_id"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:background="#151515">

    <RelativeLayout
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="56dp">

        <RelativeLayout
            android:id="@+id/search_bar"
            android:layout_width="264dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="13dp"
            android:background="@drawable/search_bar">

            <RelativeLayout
                android:id="@+id/icon_search"
                android:layout_width="48dp"
                android:layout_height="48dp">

                <View
                    android:id="@+id/vector"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/search" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/search_content"
                android:layout_width="208dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="9dp">

                <TextView
                    android:id="@+id/supporting_"
                    android:layout_width="112dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="79dp"
                    android:layout_marginBottom="15dp"
                    android:alpha="0.5"
                    android:gravity="top"
                    android:lineSpacingExtra="2sp"
                    android:text="@string/supporting_"
                    android:textAppearance="@style/supporting_"
                    android:translationY="-0.8sp" />
                <!--
                Font family: Roboto
                Line height: 18sp
                (identical to box height)
                translationY compensates for the line height adjustment of text
                -->
            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/filter_bttn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="288dp"
            android:background="@drawable/filter_bttn">

            <View
                android:id="@+id/funnel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/funnel" />
        </RelativeLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/sort"
        android:layout_width="156dp"
        android:layout_height="20dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="128dp" >
        <TextView
            android:id="@+id/text"
            android:layout_width="136dp"
            android:layout_height="20dp"
            android:text="@string/sort_text"
            android:textAppearance="@style/sort_text"
            android:lineSpacingExtra="4sp"
            android:translationY="-1.8sp"
            android:gravity="end|top"
            />
        <!--
        Font family: Roboto
        Line height: 20sp
        (identical to box height)
        translationY compensates for the line height adjustment of text
        -->
        <RelativeLayout
            android:id="@+id/arrow_down_"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="2dp"
            android:background="@drawable/arrow_down_up"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/content"
        android:layout_width="328dp"
        android:layout_height="400dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="164dp"
        android:layout_marginEnd="67dp">

        <RelativeLayout
            android:id="@+id/course_1"
            android:layout_width="328dp"
            android:layout_height="236dp"
            android:background="@drawable/course_1">

            <RelativeLayout
                android:id="@+id/top_section"
                android:layout_width="328dp"
                android:layout_height="114dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/cover_1">


                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="328dp"
                    android:layout_height="114dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/cover_course_1"
                    android:contentDescription="cover image">

                </ImageView>

                <ImageView
                    android:id="@+id/bookmark"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="92dp"
                    android:background="@drawable/bookmark"
                    android:contentDescription="bookmark image">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/info"
                    android:layout_width="137dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="84dp">

                    <RelativeLayout
                        android:id="@+id/info_1"
                        android:layout_width="46dp"
                        android:layout_height="22dp"
                        android:background="@drawable/info_1">

                        <RelativeLayout
                            android:id="@+id/frame_903"
                            android:layout_width="44dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="1dp"
                            android:layout_marginBottom="3dp">

                            <ImageView
                                android:id="@+id/star_fill"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginEnd="31dp"
                                android:layout_marginBottom="2dp"
                                android:background="@drawable/star_fill">

                            </ImageView>

                            <TextView
                                android:id="@+id/star_count"
                                android:layout_width="18dp"
                                android:layout_height="13dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="2dp"
                                android:gravity="top"
                                android:lineSpacingExtra="0sp"
                                android:text="@string/star_count"
                                android:textAppearance="@style/star_count" />
                            <!--
                            Font family: Roboto
                            Line height: 14sp
                            (identical to box height)
                            -->
                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/info_2"
                        android:layout_width="87dp"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/info_2">

                        <TextView
                            android:id="@+id/text_2_info_2"
                            android:layout_width="75dp"
                            android:layout_height="14dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="5dp"
                            android:layout_marginBottom="4dp"
                            android:gravity="top"
                            android:lineSpacingExtra="0sp"
                            android:text="@string/some_id"
                            android:textAppearance="@style/some_id" />
                        <!--
                        Font family: Roboto
                        Line height: 14sp
                        (identical to box height)
                        -->

                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/bottom_sect"
                android:layout_width="300dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="130dp">


                <RelativeLayout
                    android:id="@+id/bottom_info"
                    android:layout_width="296dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/bottom_title"
                        android:layout_width="296dp"
                        android:layout_height="18dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="66dp"
                        android:gravity="top"
                        android:lineSpacingExtra="-1sp"
                        android:text="@string/bottom_title"
                        android:textAppearance="@style/bottom_title" />
                    <!--
                    Font family: Roboto
                    Line height: 18sp
                    (identical to box height)
                    -->
                    <RelativeLayout
                        android:id="@+id/bottom_info_2"
                        android:layout_width="296dp"
                        android:layout_height="60dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/description"
                            android:layout_width="296dp"
                            android:layout_height="32dp"
                            android:alpha="0.7"
                            android:gravity="top"
                            android:lineSpacingExtra="2sp"
                            android:text="@string/description"
                            android:textAppearance="@style/description"
                            android:translationY="-0.97sp" />
                        <!--
                        Font family: Roboto
                        Line height: 16sp
                        translationY compensates for the line height adjustment of text
                        -->
                        <TextView
                            android:id="@+id/price"
                            android:layout_width="43dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="249dp"
                            android:layout_marginBottom="5dp"
                            android:gravity="top"
                            android:lineSpacingExtra="-1sp"
                            android:text="@string/price"
                            android:textAppearance="@style/price" />
                        <!--
                        Font family: Roboto
                        Line height: 18sp
                        (identical to box height)
                        -->
                        <RelativeLayout
                            android:id="@+id/button_more"
                            android:layout_width="200dp"
                            android:layout_height="13dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="200dp"
                            android:layout_marginTop="39dp">

                            <TextView
                                android:id="@+id/button_more_text"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="top"
                                android:lineSpacingExtra="1sp"
                                android:text="@string/button_more_text"
                                android:textAppearance="@style/button_more_text"
                                android:translationY="-0.47sp" />
                            <!--
                            Font family: Roboto
                            Line height: 15sp
                            (identical to box height)
                            translationY compensates for the line height adjustment of text
                            -->

                            <ImageView
                                android:id="@+id/arrow_right"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/arrow_right_short_fill" />


                        </RelativeLayout>

                    </RelativeLayout>


                </RelativeLayout>
            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/navigation_"
        android:layout_width="360dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/navigation_"
        android:elevation="32dp">

        <RelativeLayout
            android:id="@+id/main"
            android:layout_width="109.33dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="247dp">


            <RelativeLayout
                android:id="@+id/state_layer"
                android:layout_width="80dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/house"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/house" />

            </RelativeLayout>

            <TextView
                android:id="@+id/label_text"
                android:layout_width="109.33dp"
                android:layout_height="16dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="6dp"
                android:gravity="center_horizontal|top"
                android:lineSpacingExtra="2sp"
                android:text="@string/house_text"
                android:textAppearance="@style/house_text"
                android:translationY="-0.97sp" />
            <!--
            Font family: Roboto
            Line height: 16sp
            (identical to box height)
            translationY compensates for the line height adjustment of text
            -->
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/favorite"
            android:layout_width="109.33dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="126dp">


            <RelativeLayout
                android:id="@+id/favorite_layer"
                android:layout_width="80dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/favorite_image"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/favorite" />

            </RelativeLayout>

            <TextView
                android:id="@+id/favorite_text"
                android:layout_width="109.33dp"
                android:layout_height="16dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="6dp"
                android:gravity="center_horizontal|top"
                android:lineSpacingExtra="2sp"
                android:text="@string/favorite_text"
                android:textAppearance="@style/favorite_text"
                android:translationY="-0.97sp" />
            <!--
            Font family: Roboto
            Line height: 16sp
            (identical to box height)
            translationY compensates for the line height adjustment of text
            -->
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/account"
            android:layout_width="109.33dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp">


            <RelativeLayout
                android:id="@+id/account_layer"
                android:layout_width="80dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/account_image"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/person" />

            </RelativeLayout>

            <TextView
                android:id="@+id/account_text"
                android:layout_width="109.33dp"
                android:layout_height="16dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="6dp"
                android:gravity="center_horizontal|top"
                android:lineSpacingExtra="2sp"
                android:text="@string/house_text"
                android:textAppearance="@style/account_text"
                android:translationY="-0.97sp" />
            <!--
            Font family: Roboto
            Line height: 16sp
            (identical to box height)
            translationY compensates for the line height adjustment of text
            -->
        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>


